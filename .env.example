# Optional live execution only. Never commit populated credentials.
BENCHMARK_MODEL_ENDPOINT=https://api.openai.com/v1
BENCHMARK_MODEL_NAME=replace-with-explicit-model-snapshot
BENCHMARK_MODEL_API_KEY=replace-with-model-key
BENCHMARK_MODEL_RETRIES=2
VOLC_ACCESS_KEY_ID=replace-with-access-key
VOLC_SECRET_ACCESS_KEY=replace-with-secret-key
